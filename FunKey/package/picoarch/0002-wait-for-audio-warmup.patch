+++ b/plat_sdl.c
@@ -355,8 +355,31 @@
 	}
 }
 
+#ifdef FUNKEY_S
+/* StarFling: at boot, the amp warm-up (starfling-audio-init) holds the
+ * audio device for ~0.8 s after power-on, and opening it meanwhile fails
+ * (a resumed game then exits). Wait for its ready flag here, where audio
+ * is opened, rather than before starting the emulator: core and content
+ * loading then overlap the warm-up. Bounded, and immediate after boot. */
+#define AUDIO_READY_FLAG         "/run/starfling-audio-ready"
+#define AUDIO_READY_WAIT_STEP_MS 10
+#define AUDIO_READY_WAIT_STEPS   150
+
+static void plat_sound_wait_for_warmup(void)
+{
+	int i;
+
+	for (i = 0; i < AUDIO_READY_WAIT_STEPS && access(AUDIO_READY_FLAG, F_OK) != 0; i++)
+		SDL_Delay(AUDIO_READY_WAIT_STEP_MS);
+}
+#endif
+
 static int plat_sound_init(void)
 {
+#ifdef FUNKEY_S
+	plat_sound_wait_for_warmup();
+#endif
+
 	if (SDL_InitSubSystem(SDL_INIT_AUDIO)) {
 		return -1;
 	}
