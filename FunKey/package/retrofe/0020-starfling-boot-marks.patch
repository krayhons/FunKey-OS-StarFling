diff --git a/RetroFE/Source/Utility/BootMark.cpp b/RetroFE/Source/Utility/BootMark.cpp
new file mode 100644
index 0000000..8639dfe
--- /dev/null
+++ b/RetroFE/Source/Utility/BootMark.cpp
@@ -0,0 +1,65 @@
+/* This file is part of RetroFE.
+ *
+ * RetroFE is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * RetroFE is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with RetroFE.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "BootMark.h"
+#include <fcntl.h>
+#include <time.h>
+#include <unistd.h>
+
+#define BOOTMARK_FLAG_PATH "/run/starfling-boot"
+#define BOOTMARK_KMSG_PATH "/dev/kmsg"
+
+// KERN_INFO keeps marks off the serial console under the "quiet" cmdline
+#define BOOTMARK_PREFIX "<6>bootmark: retrofe "
+
+int BootMark::fd_ = -1;
+
+void BootMark::initialize()
+{
+    if(access(BOOTMARK_FLAG_PATH, F_OK) != 0)
+    {
+        return;
+    }
+
+    // CLOEXEC: launched emulators must not inherit the descriptor
+    fd_ = open(BOOTMARK_KMSG_PATH, O_WRONLY | O_CLOEXEC);
+}
+
+bool BootMark::enabled()
+{
+    return fd_ >= 0;
+}
+
+void BootMark::mark(const std::string &label)
+{
+    if(fd_ < 0)
+    {
+        return;
+    }
+
+    // One write() is one kernel log record, so marks from the init thread
+    // and the main thread cannot interleave
+    std::string line = BOOTMARK_PREFIX + label;
+    ssize_t written = write(fd_, line.data(), line.size());
+    (void)written;
+}
+
+double BootMark::nowMs()
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1000000.0;
+}
diff --git a/RetroFE/Source/Utility/BootMark.h b/RetroFE/Source/Utility/BootMark.h
new file mode 100644
index 0000000..61eb5ad
--- /dev/null
+++ b/RetroFE/Source/Utility/BootMark.h
@@ -0,0 +1,40 @@
+/* This file is part of RetroFE.
+ *
+ * RetroFE is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * RetroFE is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with RetroFE.  If not, see <http://www.gnu.org/licenses/>.
+ */
+#pragma once
+
+#include <string>
+
+// StarFling boot marks: timestamped lines in the kernel log, on the same
+// clock as the kernel's own messages and the init scripts' marks (see
+// /usr/local/lib/bootmark on the device).
+//
+// Marks are written only while /run/starfling-boot exists, which rcS
+// creates when the share partition has a starfling-boot folder. Otherwise
+// initialize() costs one access() call and mark() returns at once.
+class BootMark
+{
+public:
+    // Call once from main(), before any other thread starts
+    static void initialize();
+    static bool enabled();
+    static void mark(const std::string &label);
+
+    // Milliseconds on the monotonic clock, for timing a step in-process
+    static double nowMs();
+
+private:
+    static int fd_;
+};
