-void Configuration::loadAllLazyCollections()
+void Configuration::loadAllLazy()
 {
     while(!lazyCollections_.empty())
     {
         loadLazyCollection("collections." + lazyCollections_.front().name + ".");
     }
+    while(!lazyLaunchers_.empty())
+    {
+        loadLazyLauncher("launchers." + lazyLaunchers_.begin()->first + ".");
+    }
+}
+
+void Configuration::addLazyLauncher(std::string launcher, std::string file)
+{
+    std::lock_guard<std::recursive_mutex> lock(mutex_);
+    lazyLaunchers_[launcher] = file;
+}
+
+// StarFling: launcher files are only needed to start a game, but RetroFE
+// read all of them at startup (~45 ms on the RG Nano). A launcher's file
+// is now read the first time one of its keys is looked up. Nothing else
+// sets "launchers." keys, so the values are the same as before.
+void Configuration::loadLazyLauncher(const std::string &key)
+{
+    static const std::string launchersPrefix = "launchers.";
+
+    if(lazyLaunchers_.empty() || key.compare(0, launchersPrefix.size(), launchersPrefix) != 0)
+    {
+        return;
+    }
+
+    std::map<std::string, std::string>::iterator it = lazyLaunchers_.begin();
+    while(it != lazyLaunchers_.end())
+    {
+        std::string prefix = launchersPrefix + it->first + ".";
+
+        if(key.compare(0, prefix.size(), prefix) == 0)
+        {
+            std::string keyPrefix = launchersPrefix + it->first;
+            std::string file      = it->second;
+            it = lazyLaunchers_.erase(it);
+
+            if(!import(keyPrefix, file))
+            {
+                Logger::write(Logger::ZONE_ERROR, "RetroFE", "Could not import \"" + file + "\"");
+            }
+        }
+        else
+        {
+            ++it;
+        }
+    }
+}
+
+void Configuration::loadLazy(const std::string &key)
+{
+    loadLazyCollection(key);
+    loadLazyLauncher(key);
 }
 
