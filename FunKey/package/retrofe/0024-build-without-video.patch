diff --git a/RetroFE/Source/CMakeLists.txt b/RetroFE/Source/CMakeLists.txt
index e099e21..a48c624 100755
--- a/RetroFE/Source/CMakeLists.txt
+++ b/RetroFE/Source/CMakeLists.txt
@@ -3,6 +3,9 @@ cmake_minimum_required (VERSION 2.8)
 project (retrofe)
 
 set(LIBMIKMOD 0 CACHE BOOL "Link with libmikmod")
+# StarFling: without video, RetroFE no longer links GStreamer and GLib,
+# about 3.7 MB of libraries loaded at every start for nothing
+set(VIDEO 1 CACHE BOOL "Play theme videos with GStreamer")
 
 set(CMAKE_FIND_FRAMEWORK FIRST)
 set(RETROFE_DIR ${CMAKE_CURRENT_SOURCE_DIR}/..)
@@ -66,8 +69,10 @@ else()
 	find_package(SDL_ttf REQUIRED )
 	find_package(SDL_gfx REQUIRED )
 	pkg_search_module(ZLIB REQUIRED zlib)
+if(VIDEO)
 	pkg_check_modules(GSTREAMER REQUIRED gstreamer-1.0 gstreamer-video-1.0)
 	pkg_check_modules(Glib2 REQUIRED glib-2.0 gobject-2.0 gthread-2.0 gmodule-2.0)
+endif()
 	find_package(Threads REQUIRED)
 
 if(APPLE)
@@ -242,6 +247,11 @@ set(RETROFE_SOURCES
 set(EXECUTABLE_OUTPUT_PATH "${RETROFE_DIR}/Build" CACHE PATH "Build directory" FORCE)
 set(LIBRARY_OUTPUT_PATH "${RETROFE_DIR}/Build" CACHE PATH "Build directory" FORCE)
 
+if(NOT VIDEO)
+	list(REMOVE_ITEM RETROFE_SOURCES "${RETROFE_DIR}/Source/Video/GStreamerVideo.cpp")
+	add_definitions(-DRETROFE_NO_VIDEO)
+endif()
+
 include_directories(${RETROFE_INCLUDE_DIRS})
 add_executable(retrofe  ${RETROFE_SOURCES} ${RETROFE_HEADERS})
 target_link_libraries(retrofe ${RETROFE_LIBRARIES})
