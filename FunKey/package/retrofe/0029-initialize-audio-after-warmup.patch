         SDL_Delay( AUDIO_READY_WAIT_STEP_MS );
     }
 
-    if ( retVal && Mix_OpenAudio( audioRate, audioFormat, audioChannels, audioBuffers ) == -1 )
+    // The warm-up sets its flag as its player exits, possibly just before
+    // the kernel releases the device, so retry briefly (also bounded).
+    bool audioOpen = false;
+    for ( int i = 0; retVal && !audioOpen && i < AUDIO_OPEN_TRIES; i++ )
+    {
+        if ( i > 0 )
+        {
+            SDL_Delay( AUDIO_OPEN_RETRY_MS );
+        }
+        if ( SDL_InitSubSystem( SDL_INIT_AUDIO ) != 0 )
+        {
+            continue;
+        }
+        audioOpen = ( Mix_OpenAudio( audioRate, audioFormat, audioChannels, audioBuffers ) == 0 );
+        if ( !audioOpen )
+        {
+            SDL_QuitSubSystem( SDL_INIT_AUDIO );
+        }
+    }
+
+    if ( retVal && !audioOpen )
     {
