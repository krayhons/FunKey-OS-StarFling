+    if (retVal && SDL_Init( SDL_INIT_EVERYTHING & ~SDL_INIT_AUDIO ) != 0)
     {
         std::string error = SDL_GetError( );
         Logger::write( Logger::ZONE_ERROR, "SDL", "Initialize failed: " + error );
