-    if (retVal && SDL_Init( SDL_INIT_EVERYTHING ) != 0)
+    // StarFling: audio is left out here and initialized after the amp
+    // warm-up (below). SDL 1.2 picks its audio driver at init by probing
+    // /dev/dsp; while the warm-up holds the device the probe fails, and
