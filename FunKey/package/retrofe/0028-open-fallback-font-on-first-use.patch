+TTF_Font *Font::fallbackFont()
+{
+    if(!fallbackTried_)
+    {
+        fallbackTried_ = true;
+        fallbackFont_ = TTF_OpenFont(FALLBACK_FONT_PATH, fontSize_);
+        if (!fallbackFont_)
+        {
+            Logger::write(Logger::ZONE_INFO, "FontCache",
+                    "No fallback font at " + std::string(FALLBACK_FONT_PATH) +
+                    "; text outside this font's own coverage will not draw");
+        }
+    }
+
+    return fallbackFont_;
+}
