+void Configuration::addLazyCollection(std::string collection, std::string infoFile, std::string settingsFile)
+{
+    std::lock_guard<std::recursive_mutex> lock(mutex_);
+    LazyCollection lazy;
+    lazy.name         = collection;
+    lazy.infoFile     = infoFile;
+    lazy.settingsFile = settingsFile;
+    lazyCollections_.push_back(lazy);
+}
+
+// StarFling: RetroFE used to read every collection's info.conf and
+// settings.conf at startup (22 collections, ~115 ms of SD card reads on
+// the RG Nano). Each collection is now read the first time one of its
+// keys is looked up, in the same order as before (info.conf, then
+// settings.conf), so its values are the same as with the eager import.
+void Configuration::loadLazyCollection(const std::string &key)
+{
+    static const std::string collectionsPrefix = "collections.";
+
+    if(lazyCollections_.empty() || key.compare(0, collectionsPrefix.size(), collectionsPrefix) != 0)
+    {
+        return;
+    }
+
+    for(size_t i = 0; i < lazyCollections_.size(); )
+    {
+        std::string prefix = collectionsPrefix + lazyCollections_[i].name + ".";
+
+        if(key.compare(0, prefix.size(), prefix) == 0)
+        {
+            LazyCollection lazy = lazyCollections_[i];
+            lazyCollections_.erase(lazyCollections_.begin() + i);
+
+            std::string keyPrefix = collectionsPrefix + lazy.name;
+            import(lazy.name, keyPrefix, lazy.infoFile, false);
+            if(!import(lazy.name, keyPrefix, lazy.settingsFile, false))
+            {
+                Logger::write(Logger::ZONE_INFO, "RetroFE", "Could not import \"" + lazy.settingsFile + "\"");
+            }
+        }
+        else
+        {
+            i++;
+        }
+    }
+}
+
+void Configuration::loadAllLazyCollections()
+{
+    while(!lazyCollections_.empty())
+    {
+        loadLazyCollection("collections." + lazyCollections_.front().name + ".");
+    }
+}
