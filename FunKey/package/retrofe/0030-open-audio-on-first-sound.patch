@@ -260,11 +257,35 @@ bool SDL::initialize( Configuration &config )
         }
     }
 
+    // StarFling: the mixer opens when the first sound loads or plays
+    // (openAudioIfPending), not here: waiting for the amp warm-up here
+    // held the menu for up to ~0.2 s. Sounds load with the layout, after
+    // the warm-up is usually done.
+    audioPending_ = retVal;
+
+    return retVal;
+}
+
+
+// Opens the mixer if initialize left it for later. Called from the main
+// thread before any SDL_mixer use.
+void SDL::openAudioIfPending( )
+{
+    if ( !audioPending_ )
+    {
+        return;
+    }
+    audioPending_ = false;
+
+    int    audioRate     = MIX_DEFAULT_FREQUENCY;
+    Uint16 audioFormat   = MIX_DEFAULT_FORMAT; /* 16-bit stereo */
+    int    audioChannels = 1;
+    int    audioBuffers  = 4096;
+
     // StarFling: the boot's amp warm-up (starfling-audio-init) holds the
     // audio device for ~0.8 s after power-on, and opening it meanwhile
-    // fails. Wait for its ready flag here rather than before starting
-    // RetroFE: by now ~0.5 s of startup has passed, so there is usually
-    // nothing left to wait for. Bounded, so audio never blocks the menu.
+    // fails. Wait for its ready flag. Bounded, so audio never blocks the
+    // menu for long.
     for ( int i = 0; i < AUDIO_READY_WAIT_STEPS && access( AUDIO_READY_FLAG, F_OK ) != 0; i++ )
     {
         SDL_Delay( AUDIO_READY_WAIT_STEP_MS );
@@ -273,7 +294,7 @@ bool SDL::initialize( Configuration &config )
     // The warm-up sets its flag as its player exits, possibly just before
     // the kernel releases the device, so retry briefly (also bounded).
     bool audioOpen = false;
-    for ( int i = 0; retVal && !audioOpen && i < AUDIO_OPEN_TRIES; i++ )
+    for ( int i = 0; !audioOpen && i < AUDIO_OPEN_TRIES; i++ )
     {
         if ( i > 0 )
         {
@@ -290,14 +311,12 @@ bool SDL::initialize( Configuration &config )
         }
     }
 
-    if ( retVal && !audioOpen )
+    if ( !audioOpen )
     {
         std::string error = Mix_GetError( );
         Logger::write( Logger::ZONE_WARNING, "SDL", "Audio initialize failed: " + error );
     }
 
-    return retVal;
-
 }
 
 
@@ -307,6 +326,7 @@ bool SDL::deInitialize( )
     std::string error = SDL_GetError( );
     Logger::write( Logger::ZONE_INFO, "SDL", "DeInitializing" );
 
+    audioPending_ = false;
     Mix_CloseAudio( );
 
     while(Mix_Init(0))
