#!/bin/sh

# Uncomment the following line to get debug info
#set -x

SELF=${SELF:-$(basename $0)}
LOCK_FILE=/var/lock/share.lock
USB_GADGET_DELAY_S=3
BACKING_STORE_WAIT_TENTHS=50

source /usr/local/lib/utils
source usb_gadget

# The USB network interface file
USB_IF=/etc/network/interfaces.d/usb0

# The USB mass storage backing store file or partition
BACKING_STORE_FILE=/sys/kernel/config/usb_gadget/FunKey/functions/mass_storage.mmcblk0p4/lun.0/file

# Unmount a local share
unmount_share () {

    umount /mnt || die 1 "cannot unmount the backing store partition"
    return 0
}

# Mount a share locally
# Create the given directories under a base directory, forking mkdir only
# for those that do not exist yet
ensure_dirs () {
    local base="${1}"
    shift
    local dir
    for dir in "$@"; do
	[ -d "${base}/${dir}" ] || mkdir -p "${base}/${dir}"
    done
}

mount_share () {

    mount | grep -q /dev/mmcblk0p4
    if [ $? -ne 0 ]; then

	# Check if the FAT32 partition has been unmounted cleanly
	fsck.fat -n /dev/mmcblk0p4 2>/dev/null | egrep -q "Dirty bit"
	if [ $? -eq 0 ]; then

	    # The FAT32 partition was not cleanly unmounted, try to
	    # clean it
	    warn "the backing store partition was not properly unmounted"
	    #warn "the backing store partition was not properly
	    #unmounted, clean it"
    	    # fsck.fat -a -t -w /dev/loop0 >/dev/null 2>&1
	    # if [ $? -gt 1 ]; then
	    #     die 3 "cannot clean backing store file"
	    # fi
	fi

	# Mount the backing store file locally
	mount /mnt/ || die 4 "cannot mount backing store partition"
    fi

    # Create the directory structure if required. Test each directory with
    # the shell's own [ -d ] and run mkdir only for the missing ones: the
    # same result as before, without a mkdir fork on every boot.
    #(cd /mnt; mkdir -p "Applications" "Emulators" "Games" "Atari lynx" "Game Boy" "Game Boy Color" "Game Boy Advance" "Game Gear" "Neo Geo Pocket" "NES" "PS1" "PS1/bios" "Sega Genesis" "Sega Master System" "SNES" "WonderSwan" "PCE-TurboGrafx")
    ensure_dirs /mnt "PICO-8" "Pokemon Mini" "Final Burn Alpha 2012" "MAME 2000" "Libretro/cores" "FunKey/.picoarch/system" "Native games" "Applications" "Emulators" "Atari lynx" "Game Boy" "Game Boy Color" "Game Boy Advance" "Game Gear" "Neo Geo Pocket" "NES" "PS1" "Sega Genesis" "Sega Master System" "SNES" "WonderSwan" "PCE-TurboGrafx"
    ensure_dirs /mnt/FunKey/.retrofe/collections "PICO-8" "Pokemon Mini" "Final Burn Alpha 2012" "MAME 2000" "Atari lynx" "Game Boy" "Game Boy Color" "Game Boy Advance" "Game Gear" "Neo Geo Pocket" "NES" "PS1" "Sega Genesis" "Sega Master System" "SNES" "WonderSwan" "PCE-TurboGrafx" "Libretro" "Native games" "Main"

    # Check if there is a firmware update file. Test each glob match itself:
    # "[ -f /mnt/FunKey-*.fwu ]" receives one argument per match, so with two
    # or more update files on the card it failed with "binary operator
    # expected" and the pending update was silently skipped on every boot.
    for file in /mnt/FunKey-*.fwu; do
	if [ -f "${file}" ]; then
	    warn "found a firmware update file, going into recovery mode"
	    notif set 0 "^^^^^^^^        UPDATING...^^^^^^^^"
	    recovery_mode
	    # recovery_mode reboots, so this never runs today; if it ever
	    # returns, entering recovery once per boot is the right count.
	    break
	fi
    done

    # No software-update (.swu) handling here. There used to be a loop, but
    # its glob was discarded inside the command substitution, so it never
    # installed anything. Removing rather than repairing it: no script,
    # config or document anywhere references a .swu file (the only hit is
    # the loop itself), so nothing users do can depend on it, and a repaired
    # loop would reinstall the same file on every boot -- nothing deleted
    # it after a successful install. Firmware updates above (via recovery
    # mode) are the supported route.
    return 0
}

# Initialize the backing store if needed and mount it locally
init_share () {
    if [ -f ${LOCK_FILE} ]; then
	return 0
    fi
    touch ${LOCK_FILE}

    # Initialize the USB gadget in the background, after the frontend or
    # game is up: only MOUNT USB and adb use it, and with adb it includes a
    # fixed "sleep 5". On the boot path it cost ~0.1 s, and 5 s more with
    # adb. Started right away, even at nice 19, it slowed the init scripts
    # after it (module loading and, with a cable in, USB enumeration run
    # in the kernel at normal priority), hence the delay (StarFling 1.3).
    nice -n 19 sh -c "sleep ${USB_GADGET_DELAY_S}; source /usr/local/sbin/usb_gadget; init_usb_gadget" >/dev/null 2>&1 &

    # Mount the backing store partition locally
    mount_share
    return 0
}

# Stop sharing the backing store partition
stop_share () {

    # Stop sharing the backing store partition. Without a mass storage
    # function (adb on, or the gadget not set up yet) nothing was shared:
    # just remount, or /mnt stays missing until a reboot.
    if [ -e $BACKING_STORE_FILE ]; then
	echo > $BACKING_STORE_FILE || die 11 "the backing store partition is still mounted on host"
    fi

    # Mount the backing store partition locally
    mount_share

    info "stopped sharing the backing store partition"

    return 0
}

# Wait up to BACKING_STORE_WAIT_TENTHS for the gadget's mass storage
# function; fails if it does not appear
wait_for_backing_store () {
    local tenths=0
    while [ ! -e $BACKING_STORE_FILE ]; do
	[ ${tenths} -ge ${BACKING_STORE_WAIT_TENTHS} ] && return 1
	sleep 0.1
	tenths=$((tenths + 1))
    done
    return 0
}

# Start sharing the backing store partition
start_share () {

    # 0) The USB gadget is set up in the background a few seconds after boot
    #    (init_share), and with adb on it has no mass storage function at
    #    all. Wait for the function before giving up /mnt, and refuse if it
    #    never comes: unmounting first left the games missing until reboot.
    wait_for_backing_store || die 16 "USB sharing impossible, no USB drive function (is /mnt/adb set?)"

    # 1) Check if the backing store partition is already shared
    cat $BACKING_STORE_FILE | egrep -q ^/dev/mmcblk0p4 && die 12 "the backing store partition is already shared"

    # 2) Check if USB data is connected
    is_usb_data_connected > /dev/null 2>&1 || die 13 "USB sharing impossible, not connected to a host"

    # 3) Unmount the backing store partition if it is locally mounted
    unmount_share

    # 4) Everything is now clear to start sharing the backing store partition
    info "start sharing the backing store partition"
    echo /dev/mmcblk0p4 > $BACKING_STORE_FILE || {
	mount_share
	die 14 "cannot share the backing store partition"
    }
}

# Return if currently sharing
is_share_started () {

    cat $BACKING_STORE_FILE | egrep -q ^/dev/mmcblk0p4
    local res=$?
    if [ "$res" == "0" ]; then
        echo "yes"
    else
        echo "no"
    fi
    return $res
}

is_usb_data_connected () {

    # Get USB state
    local usb_present=$(cat /sys/class/power_supply/axp20x-usb/present)

    # Get udc state
    local udc_state=$(cat /sys/class/udc/musb-hdrc.1.auto/state)

    if [ "x${udc_state}" = "xconfigured" -a "${usb_present}" -eq 1 ]; then

	# Connected succesfully to a host
	echo "yes"
	return 0
    else
	echo "no"
	return 1
    fi
}

case "$1" in

    init)
	init_share
	;;

    start)
	start_share
	;;
    
    stop)
	stop_share
	;;

    is_sharing)
        is_share_started
        ;;

    is_usb_data_connected)
	is_usb_data_connected
	;;

    *)
	die 15 "Usage $0 {init|start|stop|is_sharing}"
	;;
esac
exit $?
