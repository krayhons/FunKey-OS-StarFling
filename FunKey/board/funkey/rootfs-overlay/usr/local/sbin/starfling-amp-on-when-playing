#!/bin/sh

# Switch the speaker amp on once a resumed game's audio stream is running.
# At boot the amp stays off until sound plays: switching it on earlier, or
# starting a stream while it is on, pops through the speaker (StarFling
# Phase 1.3). RetroFE switches the amp itself when it plays a sound; an
# emulator does not, so Instant Play starts this in the background.
# After AMP_ON_TIMEOUT_TENTHS without a running stream (a program without
# sound), it switches the amp on anyway, as boot did before.

PCM_STATUS=/proc/asound/card0/pcm0p/sub0/status
AMP_ON_TIMEOUT_TENTHS=30

tenths=0
while [ ${tenths} -lt ${AMP_ON_TIMEOUT_TENTHS} ]; do
    read -r state < "${PCM_STATUS}"
    case "${state}" in
	*RUNNING*)
	    break
	    ;;
    esac
    sleep 0.1
    tenths=$((tenths + 1))
done

audio_amp on >/dev/null 2>&1
