From 61b05989bde5e027cd94706a1227e786086df7fd Mon Sep 17 00:00:00 2001
From: krayhons <kevin@elementkombucha.com>
Date: Fri, 30 Oct 2026 21:38:42 -0500
Subject: [PATCH] fbtft: probe asynchronously and sleep during panel init

The ST7789V init busy-waited 125 ms (mdelay after the software reset
and after SLPOUT) inside its probe, which runs synchronously at boot.
With PREEMPT_NONE on a single core this also kept the SD card's
initialisation worker off the CPU. Sleep instead, and probe the SPI
display driver asynchronously so the panel comes up while the card
initialises. The delays themselves are unchanged.
---
 drivers/staging/fbtft/fb_st7789v.c | 4 ++--
 include/linux/fbtft.h              | 1 +
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/drivers/staging/fbtft/fb_st7789v.c b/drivers/staging/fbtft/fb_st7789v.c
index 0de033a..9f8711f 100755
--- a/drivers/staging/fbtft/fb_st7789v.c
+++ b/drivers/staging/fbtft/fb_st7789v.c
@@ -104,11 +104,11 @@ static int init_display(struct fbtft_par *par)
 #ifndef SAEF_SETTINGS
 	/* Software reset */
 	write_reg(par, 0x01);
-	mdelay(5);
+	usleep_range(5000, 6000);
 
 	/* turn off sleep mode */
 	write_reg(par, 0x11);
-	mdelay(120);
+	msleep(120);
 
 	write_reg(par, 0x36, 0x00);
 	write_reg(par, 0x3A, 0x05);
diff --git a/include/linux/fbtft.h b/include/linux/fbtft.h
index daeb795..986ce7a 100644
--- a/include/linux/fbtft.h
+++ b/include/linux/fbtft.h
@@ -426,6 +426,7 @@ MODULE_DEVICE_TABLE(of, dt_ids);                                           \
 static struct spi_driver fbtft_driver_spi_driver = {                       \
 	.driver = {                                                        \
 		.name   = _name,                                           \
+		.probe_type = PROBE_PREFER_ASYNCHRONOUS,                   \
 		.of_match_table = of_match_ptr(dt_ids),                    \
 	},                                                                 \
 	.probe  = fbtft_driver_probe_spi,                                  \
-- 
2.34.1

